{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nurie-paint",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-11",
  // 本番のURL。デプロイすると、DNS レコードと証明書が自動で作られる（nuriepaint.com は同じ Cloudflare アカウントで取得済み）。
  "routes": [
    {
      "pattern": "nuriepaint.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    // 認証メールの差出人（Resend で認証済みのドメインのアドレスにする）
    "MAIL_FROM": "ぬりえペイント <noreply@mail.nuriepaint.com>"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* は、ブラウザで直接開いた場合（メールの認証リンクなど）も必ず Worker で処理する。
    // これがないと、直接開いた /api/... が画面のトップ（index.html）に置き換わってしまう。
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ringo-mikan-paint-db",
      "database_id": "f2c1b8b6-9eda-41f8-bd9e-a15b9c2d5755"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTWORKS",
      "bucket_name": "ringo-mikan-paint-artworks"
    }
  ]
}
